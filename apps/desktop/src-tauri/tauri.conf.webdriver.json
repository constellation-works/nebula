{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build"
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "webdriver",
          "description": "Permission for the debug-only embedded WebDriver used by the CSP integration check.",
          "windows": ["main"],
          "permissions": ["wdio-webdriver:default"]
        }
      ]
    }
  }
}
